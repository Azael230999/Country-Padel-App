rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAcademyAdmin(academyId) {
      return request.auth != null && request.auth.uid == academyId;
    }

    // Solo se usa para lecturas de un documento individual (get), nunca para
    // consultas de lista — ahí sí está permitido depender de un get() a otro
    // documento.
    function isCoachOfAcademy(academyId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/coaches/$(request.auth.uid)).data.academyId == academyId;
    }

    match /coaches/{uid} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.academyId == request.auth.uid;

      // Un doc de coach nuevo puede crearlo: (a) la propia persona,
      // registrándose y arrancando como admin de su propia academia nueva
      // (mismo default que ya usa la app: academyId = su propio uid), o
      // (b) el admin de una academia existente, dando de alta a alguien de
      // su equipo con ese academyId. Sin esto, cualquiera podía crear su
      // cuenta y ponerse el academyId de una academia ajena.
      allow create: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.academyId == uid) ||
        isAcademyAdmin(request.resource.data.academyId)
      );

      // academyId no se puede cambiar después de creado — si se pudiera,
      // cualquier coach podría "mudarse" de academia solo reescribiendo su
      // propio documento y leer/aparecer donde no le corresponde.
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.academyId == resource.data.academyId;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /students/{studentId} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.uid == resource.data.coachUid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.coachUid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.coachUid;
    }

    match /groupAssignments/{academyId} {
      allow get, write: if isAcademyAdmin(academyId);
    }

    match /academyConfig/{academyId} {
      allow get, write: if isAcademyAdmin(academyId);
    }

    match /groupSchedule/{academyId} {
      allow get: if isAcademyAdmin(academyId) || isCoachOfAcademy(academyId);
      allow write: if isAcademyAdmin(academyId);
    }

    match /academyStudents/{id} {
      allow get: if true;
      allow list: if isAcademyAdmin(resource.data.academyId) ||
        (request.auth != null && request.auth.uid in resource.data.assignedCoachUids);
      allow create: if isAcademyAdmin(request.resource.data.academyId);
      allow update, delete: if isAcademyAdmin(resource.data.academyId);
    }

    match /academyEvents/{id} {
      allow get, list: if isAcademyAdmin(resource.data.academyId) ||
        (request.auth != null && request.auth.uid in resource.data.audienceUids);
      allow create: if isAcademyAdmin(request.resource.data.academyId);
      allow update, delete: if isAcademyAdmin(resource.data.academyId);
    }
  }
}
